ANTHROPIC_API_KEY=your_api_key_here

# Smart tier uses the Claude Agent SDK on your subscription by default.
# Get a token once with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Set to "api" to route the smart tier through the Developer Platform (API key) instead.
SMART_PROVIDER=

# Path to the Unity editor exe, used by the sticklers-gate Unity compile gate.
# Falls back to the Unity 6 Hub path if unset.
UNITY_EXE=

# Per-agent tier override: TIER_<AGENT>=smart|cheap|local (e.g. TIER_ENGINEER=local).
# TIER_PLANNER=local runs the Planner on the free local model instead of smart.
TIER_PLANNER=

# Base directory new projects are created under by `npm run bootstrap` (default C:/Dev).
BOOTSTRAP_BASE=

# Cost-tiered retry: escalate the engineer from its base tier to smart after this many
# failed attempts on a task (default 2; set 0 to disable). No-op if base tier is smart.
ESCALATE_AFTER=
