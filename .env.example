ANTHROPIC_API_KEY=your_api_key_here

# Smart tier uses the Claude Agent SDK on your subscription by default.
# Get a token once with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Set to "api" to route the smart tier through the Developer Platform (API key) instead.
SMART_PROVIDER=

# Path to the Unity editor exe, used by the sticklers-gate Unity compile gate.
# Falls back to the Unity 6 Hub path if unset.
UNITY_EXE=
